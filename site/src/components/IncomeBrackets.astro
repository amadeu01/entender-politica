---
// People by income bracket in PPP dollars: the latest year as a table with range bars,
// the typical income beside it, and every year as small multiples (a band for the
// estimated range, a line at its midpoint). Thresholds and shares come only from
// income_brackets.json; shares are estimates by linear interpolation (ADR 0011).
import Chart from "./Chart.astro";
import { incomeBrackets, indicator, series } from "../lib/data";
import { SOURCE_NAMES, UI, formatNumber, type Lang } from "../lib/i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const data = incomeBrackets();
const pct = (n: number, d = 1) => `${formatNumber(n, lang, d)}%`;
const reais = (n: number) => `R$ ${formatNumber(n, lang, 0)}`;
const usd = (n: number) => `${t.ppp} ${formatNumber(n, lang, 0)}`;
// A share as text: a range is written out, a point is an approximation.
const share = (low: number, high: number): string => {
  const a = pct(low);
  const b = pct(high);
  if (high < 0.05) return t.lessThan(pct(0.1));
  return a === b || Math.abs(high - low) < 0.05 ? t.approx(pct((low + high) / 2)) : t.rangeBetween(a, b);
};
const base = data?.config.ppp_base_year ?? 0;
// PNAD series breaks, read from the catalog entry of one percentile indicator.
const breaks = data
  ? indicator(Object.values(data.config.percentile_indicators)[0]).series_breaks
      .filter((b) => b.geo === null || b.geo === "BRA")
      .sort((a, b) => a.year - b.year)
  : [];
// A year is affected when an odd number of breaks lie at or before it (a break opens, the next closes).
const affected = (year: number): boolean => breaks.filter((b) => b.year <= year).length % 2 === 1;
const last = data?.years[data.years.length - 1];
const first = data?.years[0];
const th = data?.config.thresholds_usd_ppp ?? [];
const bracketLabel = (i: number): string => {
  if (i === 0) return t.upTo(usd(th[0]));
  if (i === th.length) return t.moreThan(usd(th[th.length - 1]));
  return t.fromTo(usd(th[i - 1]), usd(th[i]));
};
const reaisLabel = (i: number): string => {
  const x = last!.thresholds_brl;
  if (i === 0) return t.upTo(reais(x[0]));
  if (i === x.length) return t.moreThan(reais(x[x.length - 1]));
  return t.fromTo(reais(x[i - 1]), reais(x[i]));
};
const scale = last ? Math.max(...last.brackets.map((b) => b.high), 1) : 1;
const medianYear = Math.max(
  ...series("ibge_sidra.rdpc_mediana_real_pnadc").observations.map((o) => o.year),
);

// Small multiples: one panel per bracket, a shared y axis from 0.
const W = 220;
const H = 110;
const pad = { l: 34, r: 6, t: 8, b: 20 };
const ymax = data ? Math.ceil(Math.max(...data.years.flatMap((y) => y.brackets.map((b) => b.high))) / 10) * 10 : 10;
const x = (year: number) =>
  pad.l + ((year - first!.year) / Math.max(1, last!.year - first!.year)) * (W - pad.l - pad.r);
const y = (v: number) => pad.t + (1 - v / ymax) * (H - pad.t - pad.b);
const panels = data
  ? data.config.labels.map((label, i) => {
      const hi = data.years.map((r) => `${x(r.year).toFixed(1)},${y(r.brackets[i].high).toFixed(1)}`);
      const lo = data.years
        .map((r) => `${x(r.year).toFixed(1)},${y(r.brackets[i].low).toFixed(1)}`)
        .reverse();
      const pt = data.years.map((r) => ({
        year: r.year,
        x: x(r.year),
        y: y((r.brackets[i].low + r.brackets[i].high) / 2),
      }));
      // One segment per pair of consecutive years; dashed when either end is in a break.
      const segs = pt.slice(1).map((b, k) => {
        const a = pt[k];
        return {
          pts: `${a.x.toFixed(1)},${a.y.toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`,
          dashed: affected(a.year) || affected(b.year),
        };
      });
      return { label, i, band: [...hi, ...lo].join(" "), segs };
    })
  : [];
const ticks = [0, ymax / 2, ymax];
const flagged = data ? data.years.filter((r) => affected(r.year)).map((r) => r.year) : [];
const shade =
  flagged.length > 0 && data
    ? { x1: x(Math.max(first!.year, flagged[0] - 0.5)), x2: x(Math.min(last!.year, flagged[flagged.length - 1] + 0.5)) }
    : null;
---

{
  data && last && first && (
    <section class="brackets" aria-labelledby="faixas-titulo">
      <h3 id="faixas-titulo">{t.bracketsTitle}</h3>
      <p class="meta">
        <strong>{t.pppTerm}.</strong>{" "}{t.pppExplain(base)}
      </p>
      <div class="table-scroll">
        <table class="data">
          <caption>{t.bracketsCaption(last.year)}</caption>
          <thead>
            <tr>
              <th scope="col">{t.bracket}</th>
              <th scope="col">{t.inReais(last.year)}</th>
              <th scope="col" class="num">{t.shareOfPeople}</th>
            </tr>
          </thead>
          <tbody>
            {last.brackets.map((b, i) => (
              <tr>
                <th scope="row">{bracketLabel(i)}</th>
                <td>{reaisLabel(i)}</td>
                <td class="num">
                  {share(b.low, b.high)}
                  <span class="bar" aria-hidden="true">
                    <span class="solid" style={`width:${(b.low / scale) * 100}%`} />
                    <span class="range" style={`width:${((b.high - b.low) / scale) * 100}%`} />
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="meta">
        {t.interpolationNote}. {t.reaisPerUsd(base)} ({last.year}): {formatNumber(last.reais_per_usd_ppp, lang, 2)}. {t.reaisPerUsdNote(base)}
      </p>
      <details>
        <summary>{t.sourcesLabel}</summary>
        <ul class="meta">
          {data.sources.map((s) => (
            <li>
              {SOURCE_NAMES[s.source_id]?.[lang] ?? s.source_id} · {s.indicator_id} · {t.version} {s.source_version} · {t.retrieved} {s.retrieved_at.slice(0, 10)}
            </li>
          ))}
        </ul>
      </details>

      <Chart
        lang={lang}
        id="renda-mediana"
        title={t.medianTitle}
        alt={t.medianAlt}
        indicators={["ibge_sidra.rdpc_mediana_real_pnadc", "ibge_sidra.trabalho_mediana_real_pnadc"]}
        geographies={["BRA"]}
      />
      <p class="meta">{t.medianNote(medianYear)}</p>

      <h3>{t.overTime}</h3>
      <div class="panels">
        {panels.map((p) => (
          <figure>
            <figcaption>{bracketLabel(p.i)}</figcaption>
            <svg
              viewBox={`0 0 ${W} ${H}`}
              role="img"
              aria-label={t.overTimeAlt(bracketLabel(p.i), first.year, last.year)}
            >
              {ticks.map((v) => (
                <g>
                  <line x1={pad.l} x2={W - pad.r} y1={y(v)} y2={y(v)} class="grid" />
                  <text x={pad.l - 4} y={y(v) + 3} text-anchor="end">{v}%</text>
                </g>
              ))}
              {shade && <rect x={shade.x1} y={pad.t} width={shade.x2 - shade.x1} height={H - pad.t - pad.b} class="brk" />}
              <polygon points={p.band} class="band" />
              {p.segs.map((sg) => (
                <polyline points={sg.pts} class={sg.dashed ? "mid dashed" : "mid"} fill="none" />
              ))}
              <text x={pad.l} y={H - 5}>{first.year}</text>
              <text x={W - pad.r} y={H - 5} text-anchor="end">{last.year}</text>
            </svg>
          </figure>
        ))}
      </div>
      <p class="meta">{t.interpolationNote}. {t.overTimeLegend}{flagged.length > 0 && ` ${t.breakLegend}`}</p>
      {
        breaks.length > 0 && (
          <div class="meta">
            <strong>{t.seriesBreaks}:</strong>
            <ul>
              {breaks.map((b) => (
                <li>
                  <strong>{b.year}:</strong> {b.note[lang]}
                </li>
              ))}
            </ul>
          </div>
        )
      }
      <details>
        <summary>{t.tableView}</summary>
        <div class="table-scroll">
          <table class="data">
            <caption>{t.bracketsTitle}</caption>
            <thead>
              <tr>
                <th scope="col">{t.year}</th>
                {data.config.labels.map((_, i) => <th scope="col" class="num">{bracketLabel(i)}</th>)}
              </tr>
            </thead>
            <tbody>
              {data.years.map((r) => (
                <tr>
                  <th scope="row">
                    {r.year}
                    {affected(r.year) && <span class="meta"> ({t.breakFlag})</span>}
                  </th>
                  {r.brackets.map((b) => <td class="num">{share(b.low, b.high)}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    </section>
  )
}

<style>
  .brackets {
    margin: 1.5rem 0;
  }
  .bar {
    display: flex;
    height: 8px;
    margin-top: 0.25rem;
    min-width: 6rem;
  }
  .bar .solid {
    background: var(--series-1);
    border-radius: 0 4px 4px 0;
  }
  .bar .range {
    background: var(--series-1);
    opacity: 0.35;
    border-radius: 0 4px 4px 0;
  }
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }
  .panels figure {
    margin: 0;
  }
  .panels figcaption {
    font-size: 0.9rem;
    color: var(--ink-2);
  }
  svg {
    width: 100%;
    height: auto;
  }
  svg text {
    font-size: 9px;
    fill: var(--ink-2);
  }
  .grid {
    stroke: var(--border);
    stroke-width: 1;
  }
  .band {
    fill: var(--series-1);
    opacity: 0.3;
  }
  .mid {
    stroke: var(--series-1);
    stroke-width: 2;
  }
  .mid.dashed {
    stroke-dasharray: 3 2;
  }
  .brk {
    fill: var(--ink-2);
    opacity: 0.15;
  }
</style>
