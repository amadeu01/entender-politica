---
import View from "../../../views/Analysis.astro";
import { documents } from "../../../lib/data";

export function getStaticPaths() {
  return documents().analyses.filter((a) => a.lang === "en").map((a) => ({ params: { slug: a.slug } }));
}
const { slug } = Astro.params;
---

<View lang="en" slug={slug} />
