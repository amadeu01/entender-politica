---
// Education: an overview plus one section per sub-module (early childhood, primary, ...),
// each with the laws that shape it, the votes and amendments in their history, and the
// metrics beside them. Descriptive only (ADR 0003, ADR 0012).
import Base from "../layouts/Base.astro";
import Chart from "../components/Chart.astro";
import Notice from "../components/Notice.astro";
import VoteList from "../components/VoteList.astro";
import { eduGovernment, eduGovernments, education, indicator } from "../lib/data";
import type { EducationEvent, EducationLaw, EducationMark } from "../lib/data";
import { asset, SOURCE_NAMES, UI, UNIT_DECIMALS, UNIT_LABELS, formatNumber, url, type Lang } from "../lib/i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
const edu = education();
const lawBySlug = new Map(edu.laws.map((l) => [l.slug, l]));
const govPages = eduGovernments().map((id) => eduGovernment(id, lang));
const govHeading = lang === "pt" ? "Educação por governo" : "Education by government";
const govLede =
  lang === "pt"
    ? "O que cada governo começou, o que foi cortado e as séries do período, lado a lado."
    : "What each government started, what was cut, and the series for the period, side by side.";
const govPath = (id: string) => `${url(lang, "education")}${lang === "pt" ? "governos" : "governments"}/${id}/`;
const REGION = ["BRA", "ARG", "CHL", "COL", "MEX"];

const copy = {
  pt: {
    lede: "As normas que moldam cada etapa da educação, as votações e alterações na história delas e as métricas disponíveis, lado a lado. Escolha um subtema.",
    nav: "Subtemas da educação",
    overview: "Panorama",
    overviewLede: "Séries que cobrem o sistema inteiro, com Brasil e vizinhos. As normas de cada subtema aparecem nas abas ao lado.",
    laws: "Normas que moldam este subtema",
    noLaws: "Nenhuma norma registrada ainda para este subtema.",
    votes: "Votações",
    nominal: "Votações nominais",
    nominalLede: "Placar de cada votação em plenário com registro de voto individual, segundo os dados abertos da Câmara e do Senado.",
    otherVotes: "Outros registros de votação",
    procedural: (n: number) => `Requerimentos, emendas e destaques (${n})`,
    votesNone: "Nenhuma votação registrada para este subtema.",
    result: { true: "Aprovada", false: "Rejeitada", null: "Resultado não informado" },
    byParty: "Votos por partido",
    orientations: "Orientação das bancadas",
    party: "Partido",
    download: "Baixar votos individuais (CSV)",
    fromSource: "Fonte",
    voteLabels: { "P-NRV": "presidente (não vota)", "Artigo 17": "presidente (art. 17)", LG: "licença à gestante" } as Record<string, string>,
    votesPending:
      "Só aparecem votações com registro de voto individual nos dados abertos; votações simbólicas e as de outros projetos ainda não coletados constam apenas como registro de que ocorreram, com a casa e a forma.",
    marks: "Marcos legais e métricas no mesmo ano",
    marksLede: "Valor de cada série para o Brasil no ano do evento. Uma série que muda depois de uma norma não demonstra que a norma causou a mudança, e séries de adultos mudam devagar por construção.",
    year: "Ano",
    law: "Norma",
    event: "Evento",
    planned: "Métricas planejadas, ainda não coletadas",
    plannedLede: "Estas séries ainda não estão no catálogo. O código deve ser conferido na API da fonte antes de virar indicador.",
    code: "Código na fonte",
    unverified: "Registro ainda não conferido com o texto oficial",
    identityChecked: (d: string) => `Número, ano e projeto de origem conferidos no registro oficial da Câmara em ${d}; resumo ainda não conferido com o texto`,
    bill: "Projeto",
    by: "por",
    noData: "sem dado",
    noEvents: "Sem eventos.",
    kinds: { constitutional_amendment: "Emenda constitucional", complementary_law: "Lei complementar", law: "Lei" },
    types: {
      proposed: "Apresentação",
      committee_vote: "Votação em comissão",
      plenary_vote: "Votação em plenário",
      enacted: "Sanção ou promulgação",
      amended: "Alterada",
      revoked: "Revogada",
      superseded: "Sucedida",
    },
    chambers: { camara: "Câmara", senado: "Senado", congresso: "Congresso" },
    forms: { nominal: "nominal", symbolic: "simbólica", conclusive: "caráter conclusivo", unknown: "forma não registrada" },
    alt: (name: string) => `Linhas de ${name} para o Brasil, Argentina, Chile, Colômbia e México, com faixas dos presidentes do Brasil ao fundo.`,
  },
  en: {
    lede: "The laws that shape each stage of education, the votes and amendments in their history, and the available metrics, side by side. Pick a sub-topic.",
    nav: "Education sub-topics",
    overview: "Overview",
    overviewLede: "Series that cover the whole system, with Brazil and its neighbors. Each sub-topic's laws appear in the tabs beside it.",
    laws: "Laws that shape this sub-topic",
    noLaws: "No law recorded yet for this sub-topic.",
    votes: "Votes",
    nominal: "Roll-call votes",
    nominalLede: "The tally of each plenary vote with individual vote records, from the Câmara and Senado open data.",
    otherVotes: "Other vote records",
    procedural: (n: number) => `Requests, amendments and highlights (${n})`,
    votesNone: "No vote recorded for this sub-topic.",
    result: { true: "Approved", false: "Rejected", null: "Result not reported" },
    byParty: "Votes by party",
    orientations: "Bench orientations",
    party: "Party",
    download: "Download individual votes (CSV)",
    fromSource: "Source",
    voteLabels: { "P-NRV": "chair (does not vote)", "Artigo 17": "chair (art. 17)", LG: "maternity leave" } as Record<string, string>,
    votesPending:
      "Only votes with individual records in the open data appear as roll calls; symbolic votes and votes on bills not yet collected are listed only as a record that they happened, with the chamber and form.",
    marks: "Legal milestones and metrics in the same year",
    marksLede: "Each series' value for Brazil in the event's year. A series that moves after a law does not show the law caused the change, and adult series move slowly by construction.",
    year: "Year",
    law: "Law",
    event: "Event",
    planned: "Planned metrics, not collected yet",
    plannedLede: "These series are not in the catalog yet. The code must be confirmed against the source's API before it becomes an indicator.",
    code: "Source code",
    unverified: "Record not yet checked against the official text",
    identityChecked: (d: string) => `Number, year and originating bill checked in the Câmara's official record on ${d}; summary not yet checked against the text`,
    bill: "Bill",
    by: "by",
    noData: "no data",
    noEvents: "No events.",
    kinds: { constitutional_amendment: "Constitutional amendment", complementary_law: "Complementary law", law: "Law" },
    types: {
      proposed: "Introduced",
      committee_vote: "Committee vote",
      plenary_vote: "Plenary vote",
      enacted: "Enacted",
      amended: "Amended",
      revoked: "Revoked",
      superseded: "Succeeded",
    },
    chambers: { camara: "Câmara", senado: "Senado", congresso: "Congress" },
    forms: { nominal: "roll call", symbolic: "voice vote", conclusive: "conclusive route", unknown: "form not recorded" },
    alt: (name: string) => `Lines of ${name} for Brazil, Argentina, Chile, Colombia and Mexico, with Brazil's presidents as background bands.`,
  },
}[lang];

const when = (e: { year: number; date?: string | null }) =>
  e.date ? (lang === "pt" ? e.date.split("-").reverse().join("/") : e.date) : String(e.year);
const eventLabel = (e: EducationEvent | EducationMark) => {
  const parts = [copy.types[e.type]];
  if (e.chamber) parts.push(copy.chambers[e.chamber]);
  if (e.form) parts.push(copy.forms[e.form]);
  return parts.join(" · ");
};
const isVote = (e: { type: string }) => e.type === "committee_vote" || e.type === "plenary_vote";
const show = (value: number | null | undefined, unit: string) =>
  value === null || value === undefined ? copy.noData : formatNumber(value, lang, UNIT_DECIMALS[unit] ?? 2);

const tabs = [
  { id: "panorama", label: copy.overview },
  ...edu.submodules.map((s) => ({ id: s.id, label: s.name[lang] })),
];
---

<Base lang={lang} title={t.nav.education} route="education">
  <h1>{t.nav.education}</h1>
  <p class="lede">{copy.lede}</p>
  <Notice lang={lang} />

  {
    govPages.length > 0 && (
      <section aria-labelledby="h-gov">
        <h2 id="h-gov">{govHeading}</h2>
        <p>{govLede}</p>
        <p><a href={`${url(lang, "education")}${lang === "pt" ? "como-avaliar" : "how-to-assess"}/`}>{lang === "pt" ? "Como avaliar criticamente um governo e suas políticas" : "How to assess a government and its policies critically"}</a></p>
        <ul>
          {govPages.map((g) => (
            <li><a href={govPath(g.id)}>{g.periods[g.periods.length - 1].short_name} · {g.periods[g.periods.length - 1].term[lang]}</a></li>
          ))}
        </ul>
      </section>
    )
  }

  <nav class="subnav" aria-label={copy.nav}>
    <ul>
      {tabs.map((tab) => <li><a href={`#${tab.id}`}>{tab.label}</a></li>)}
    </ul>
  </nav>

  <section id="panorama" data-tab tabindex="-1" aria-labelledby="h-panorama">
    <h2 id="h-panorama">{copy.overview}</h2>
    <p>{copy.overviewLede}</p>
    {
      edu.overview_indicators.map((id) => {
        const ind = indicator(id);
        return (
          <Chart
            lang={lang}
            id={id.replace(/\W/g, "-")}
            title={ind.name[lang]}
            alt={copy.alt(ind.name[lang])}
            indicators={[id]}
            geographies={REGION}
          />
        );
      })
    }
  </section>

  {
    edu.submodules.map((sub) => {
      const laws = sub.laws.map((slug) => lawBySlug.get(slug)).filter((l): l is EducationLaw => !!l);
      const votes = sub.events.filter(isVote);
      const main = sub.votes.filter((v) => v.main);
      const rest = sub.votes.filter((v) => !v.main);
      const inSub = new Set(sub.laws);
      const lawLink = (slug: string | null, text: string) =>
        slug && inSub.has(slug) ? <a href={`#${sub.id}--${slug}`}>{text}</a> : text;
      const shown = sub.shown_indicators.map(indicator);
      return (
        <section id={sub.id} data-tab tabindex="-1" aria-labelledby={`h-${sub.id}`}>
          <h2 id={`h-${sub.id}`}>{sub.name[lang]}</h2>
          <p class="lede">{sub.summary[lang]}</p>

          <h3>{copy.laws}</h3>
          {laws.length === 0 && <p>{copy.noLaws}</p>}
          <ul class="card-grid laws">
            {
              laws.map((law) => (
                <li class="card" id={`${sub.id}--${law.slug}`}>
                  <h4>
                    {law.designation} · {law.title[lang]}
                  </h4>
                  <p class="meta">
                    <span class="badge">{copy.kinds[law.kind]}</span>
                    {law.bill && <>{" · "}{copy.bill} {law.bill}</>}
                    {!law.verified && <>{" · "}<span class="badge unverified">{law.identity_checked ? copy.identityChecked(law.identity_checked) : copy.unverified}</span></>}
                  </p>
                  <p>{law.summary[lang]}</p>
                  <ol class="events">
                    {
                      law.events
                        .slice()
                        .sort((a, b) => (a.date ?? `${a.year}`).localeCompare(b.date ?? `${b.year}`))
                        .map((e) => (
                          <li class={isVote(e) ? "vote" : undefined}>
                            <strong>{when(e)}</strong> · {eventLabel(e)}
                            {e.by && <>{" "}{copy.by}{" "}{lawLink(e.by_slug, e.by)}</>}
                            <br />
                            {e.description[lang]}
                          </li>
                        ))
                    }
                  </ol>
                </li>
              ))
            }
          </ul>

          <h3>{copy.votes}</h3>
          {
            sub.votes.length > 0 && (
              <>
                <h4>{copy.nominal}</h4>
                <p class="meta">{copy.nominalLede}</p>
                <VoteList lang={lang} votes={main} copy={copy} when={when} />
                {rest.length > 0 && (
                  <details>
                    <summary>{copy.procedural(rest.length)}</summary>
                    <VoteList lang={lang} votes={rest} copy={copy} when={when} />
                  </details>
                )}
              </>
            )
          }
          {votes.length > 0 && <h4>{copy.otherVotes}</h4>}
          {
            votes.length === 0 && sub.votes.length === 0 ? (
              <p>{copy.votesNone}</p>
            ) : (
              <ul class="votes">
                {votes.map((m) => (
                  <li>
                    <strong>{when(m)}</strong> · {m.designation} · {eventLabel(m)}
                    <br />
                    {m.description[lang]}
                  </li>
                ))}
              </ul>
            )
          }
          <p class="meta">{copy.votesPending}</p>

          {
            sub.events.length > 0 && (
              <>
                <h3>{copy.marks}</h3>
                <p>{copy.marksLede}</p>
                <div class="table-scroll">
                  <table class="data">
                    <thead>
                      <tr>
                        <th scope="col">{copy.year}</th>
                        <th scope="col">{copy.law}</th>
                        <th scope="col">{copy.event}</th>
                        {shown.map((ind) => (
                          <th scope="col" class="num">
                            <a href={url(lang, "indicators", ind.id)}>{ind.name[lang]}</a>
                            <br />
                            <span class="meta">{UNIT_LABELS[ind.unit]?.[lang] ?? ind.unit}</span>
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {sub.events.map((m) => (
                        <tr>
                          <td>{m.year}</td>
                          <td>{m.designation}</td>
                          <td>{eventLabel(m)}{m.by ? ` ${copy.by} ${m.by}` : ""}</td>
                          {shown.map((ind) => <td class="num">{show(m.values[ind.id], ind.unit)}</td>)}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="meta">
                  {[...new Set(shown.map((ind) => SOURCE_NAMES[ind.source]?.[lang] ?? ind.source))].join("; ")}
                </p>
              </>
            )
          }

          {
            sub.indicators.map((id) => {
              const ind = indicator(id);
              return (
                <Chart
                  lang={lang}
                  id={`${sub.id}-${id.replace(/\W/g, "-")}`}
                  title={ind.name[lang]}
                  alt={copy.alt(ind.name[lang])}
                  indicators={[id]}
                  geographies={REGION}
                />
              );
            })
          }

          {
            sub.planned_metrics.length > 0 && (
              <>
                <h3>{copy.planned}</h3>
                <p>{copy.plannedLede}</p>
                <ul>
                  {sub.planned_metrics.map((m) => (
                    <li>
                      {m.name[lang]} · {SOURCE_NAMES[m.source]?.[lang] ?? m.source}
                      {m.code && <> · {copy.code}: <code>{m.code}</code></>}
                      <br />
                      <span class="meta">{m.note[lang]}</span>
                    </li>
                  ))}
                </ul>
              </>
            )
          }
        </section>
      );
    })
  }

  <Notice lang={lang} />

  <script>
    // Progressive enhancement: with JavaScript, the sub-topic links work as tabs
    // (one section at a time, chosen by the URL hash). Without it, all sections stack.
    const sections = [...document.querySelectorAll<HTMLElement>("section[data-tab]")];
    const links = [...document.querySelectorAll<HTMLAnchorElement>("nav.subnav a")];
    const hashId = () => {
      try {
        return decodeURIComponent(location.hash.slice(1));
      } catch {
        return ""; // malformed escape: fall back to the first section
      }
    };
    let current: HTMLElement | undefined;
    const show = () => {
      const hash = hashId();
      // A hash can also point inside a section (a law card): open the section holding it.
      const inner = hash ? document.getElementById(hash) : null;
      const target =
        sections.find((s) => s.id === hash) ??
        sections.find((s) => inner && s.contains(inner)) ??
        sections[0];
      for (const s of sections) s.hidden = s !== target;
      for (const a of links) {
        if (a.getAttribute("href") === `#${target.id}`) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
      // Charts drawn while their section was hidden were measured at zero width.
      window.dispatchEvent(new Event("charts:redraw"));
      if (target !== current) {
        current = target;
        // Move keyboard and screen-reader users to the section they just opened.
        if (inner && inner !== target) inner.scrollIntoView();
        else target.scrollIntoView({ block: "start" });
        target.focus({ preventScroll: true });
      }
    };
    window.addEventListener("hashchange", show);
    window.addEventListener("load", () => window.dispatchEvent(new Event("charts:redraw")));
    show();
  </script>
</Base>
