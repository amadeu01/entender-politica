---
import Base from "../layouts/Base.astro";
import Numbers from "../components/Numbers.astro";
import References from "../components/References.astro";
import { analysis, documents, geoName, policy } from "../lib/data";
import { METHOD_NAMES, UI, url, type Lang } from "../lib/i18n";
interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = UI[lang];
const p = policy(slug, lang);
const plain = (html: string) => html.replace(/<[^>]+>/g, "");
const ICON = { positive: "▲", null: "●", negative: "▼", mixed: "◆" };
const related = documents()
  .analyses.filter((a) => a.lang === lang)
  .map((a) => analysis(a.slug, lang))
  .filter((a) => a.related_policies.includes(slug));
---

<Base lang={lang} title={plain(p.name)} route="policies" slug={slug} description={plain(p.summary)}>
  <article>
    <h1 set:html={p.name} />
    <dl class="facts">
      <dt>{t.country}</dt>
      <dd>{geoName(p.country, lang)}</dd>
      <dt>{t.period}</dt>
      <dd>{p.period.start}–{p.period.end}</dd>
      <dt>{t.evidenceLevel}</dt>
      <dd><span class="badge">{t.levels[p.evidence_level]}</span></dd>
    </dl>

    <h2>{t.summary}</h2>
    <p set:html={p.summary} />
    <h2>{t.mechanism}</h2>
    <p set:html={p.mechanism} />

    <h2>{t.findings}</h2>
    <ul>
      {
        p.findings.map((f) => (
          <li>
            <p>
              <strong set:html={f.outcome} /> ·{" "}
              <span class="direction">
                <span aria-hidden="true">{ICON[f.direction]}</span> {t.directions[f.direction]}
              </span>{" "}
              · <span class="badge">{METHOD_NAMES[f.method]?.[lang] ?? f.method}</span>
            </p>
            <p>
              <span set:html={f.result} />{" "}
              {f.references.map((d) => <a href={`https://doi.org/${d}`}>[doi:{d}]</a>)}
            </p>
          </li>
        ))
      }
    </ul>

    <h2>{t.externalValidity}</h2>
    <p set:html={p.external_validity} />

    {
      p.contrary_evidence_search && (
        <>
          <h2>{t.contrarySearch}</h2>
          <p set:html={p.contrary_evidence_search} />
        </>
      )
    }

    <h2>{t.limitations}</h2>
    <ul>{p.limitations.map((l) => <li set:html={l} />)}</ul>

    {
      related.length > 0 && (
        <>
          <h2>{t.relatedAnalyses}</h2>
          <ul>
            {related.map((a) => (
              <li>
                <a href={url(lang, "analyses", a.slug)} set:html={a.title} />
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      p.numbers.length > 0 && (
        <>
          <h2>{t.numbers}</h2>
          <Numbers lang={lang} numbers={p.numbers} />
        </>
      )
    }

    <h2>{t.references}</h2>
    <References refs={p.references} />
  </article>
</Base>
