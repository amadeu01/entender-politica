---
import Base from "../layouts/Base.astro";
import { analysis, catalog, documents, guide, policy } from "../lib/data";
import { UI, asset, plain, url, type Lang } from "../lib/i18n";
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang];
type Entry = { citation: string; doi: string | null; url: string | null; usedBy: { href: string; label: string }[] };
const entries = new Map<string, Entry>();
const add = (r: { citation: string; doi: string | null; url: string | null }, href: string, label: string) => {
  const key = (r.doi ?? r.url ?? r.citation).toLowerCase();
  const e = entries.get(key) ?? { ...r, usedBy: [] };
  if (!e.usedBy.some((u) => u.href === href)) e.usedBy.push({ href, label });
  entries.set(key, e);
};
for (const i of catalog()) i.references.forEach((r) => add(r, url(lang, "indicators", i.id), i.name[lang]));
for (const d of documents().analyses.filter((a) => a.lang === lang)) {
  const a = analysis(d.slug, lang);
  a.references.forEach((r) => add(r, url(lang, "analyses", a.slug), plain(a.title)));
}
for (const d of documents().policies.filter((p) => p.lang === lang)) {
  const p = policy(d.slug, lang);
  p.references.forEach((r) => add(r, url(lang, "policies", p.slug), plain(p.name)));
}
for (const id of documents().guides) {
  const g = guide(id, lang);
  if (!g) continue;
  const label = catalog().find((i) => i.id === id)?.name[lang] ?? id;
  [...g.references_indicator, ...g.references_policies].forEach((r) => add(r, url(lang, "indicators", id), label));
}
const sorted = [...entries.values()].sort((a, b) => a.citation.localeCompare(b.citation));
---

<Base lang={lang} title={t.nav.references} route="references">
  <h1>{t.nav.references}</h1>
  <p><a href={asset("data/references.bib")} download>{t.bibtex}</a></p>
  <ol class="refs">
    {
      sorted.map((r) => (
        <li>
          {r.citation}{" "}
          {r.doi ? <a href={`https://doi.org/${r.doi}`}>doi:{r.doi}</a> : r.url && <a href={r.url}>{r.url}</a>}
          <br />
          <span class="meta">
            {t.usedIn}:{" "}
            {r.usedBy.map((u, n) => (
              <>
                {n > 0 && " · "}
                <a href={u.href}>{u.label}</a>
              </>
            ))}
          </span>
        </li>
      ))
    }
  </ol>
</Base>
